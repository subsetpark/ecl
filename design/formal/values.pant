module ECL_VALUES.

> This model is normative for the closed value-kind universe; immutable scalar
> and aggregate content; whole-value matching; dictionary key identity;
> recursive readability; and hash congruence. It abstracts over concrete
> storage, float encoding, source grammar, printing, pervasion, and the
> operations that construct or consume values.
>
Value.
ValueType.

> There are nine value kinds.
value-type value: Value => ValueType.
int-type => ValueType.
float-type => ValueType.
char-type => ValueType.
symbol-type => ValueType.
list-type => ValueType.
dict-type => ValueType.
task-type => ValueType.
port-type => ValueType.
address-type => ValueType.
kind-name kind: ValueType => String.
---
> The value-kind universe is closed: every value has one of these nine kinds.
value-type value = int-type or
value-type value = float-type or
value-type value = char-type or
value-type value = symbol-type or
value-type value = list-type or
value-type value = dict-type or
value-type value = task-type or
value-type value = port-type or
value-type value = address-type.

> `kind-name` is the name `type` reports for a kind. The nine names differ, so
> the kinds are distinct and the total `value-type` rule assigns exactly one
> kind to every value.
kind-name int-type = "int" and
kind-name float-type = "float" and
kind-name char-type = "char" and
kind-name symbol-type = "symbol" and
kind-name list-type = "list" and
kind-name dict-type = "dict" and
kind-name task-type = "task" and
kind-name port-type = "port" and
kind-name address-type = "address".

where

> Scalar payloads and aggregate contents determine value identity within their
> respective kinds. Numeric magnitude separately determines mathematical
> matching across int and float, so distinct float payloads such as positive
> and negative zero may still match. A list's contents are finite and ordered.
> A dictionary maps keys to values, and whole-value matching is its key
> identity. The model says nothing of how many entries a dictionary holds or
> in what order.
>
NumericMagnitude.
FloatPayload.

int-payload value: Value, value-type value = int-type => Int.
float-payload value: Value, value-type value = float-type => FloatPayload.
char-codepoint value: Value, value-type value = char-type => Nat0.
symbol-spelling value: Value, value-type value = symbol-type => String.
list-length value: Value, value-type value = list-type => Nat0.
list-element value: Value, index: Nat,
  value-type value = list-type,
  index <= list-length value => Value.
address-mailbox value: Value, value-type value = address-type => Value.
dict-has-key? dictionary: Value, key: Value,
  value-type dictionary = dict-type => Bool.
dict-value-for-key dictionary: Value, key: Value,
  value-type dictionary = dict-type,
  dict-has-key? dictionary key => Value.

numeric-value? value: Value => Bool.
numeric-magnitude value: Value, numeric-value? value => NumericMagnitude.
boolean-value? value: Value => Bool.
string-value? value: Value => Bool.
readable? value: Value => Bool.
value-hash value: Value => Int.
---
> Numbers are exactly the int and float values.
numeric-value? value <->
  (value-type value = int-type or value-type value = float-type).

> An int's payload is a signed 64-bit integer.
int-payload value >= 0 - 2147483648 * 4294967296 and
int-payload value <= 2147483648 * 4294967296 - 1.

> A char's payload is one Unicode scalar value.
char-codepoint value <= 1114111 and
~(char-codepoint value >= 55296 and char-codepoint value <= 57343).

> Scalar payloads determine value identity within each scalar kind.
int-payload left = int-payload right -> left = right.
float-payload left = float-payload right -> left = right.
char-codepoint left = char-codepoint right -> left = right.
symbol-spelling left = symbol-spelling right -> left = right.

> A list is a finite ordered sequence. Its length and positional elements
> determine its value identity.
list-length left = list-length right and
(all index: Nat, index <= list-length left |
  list-element left index = list-element right index) ->
  left = right.

> Booleans are exactly the int values 0 and 1.
boolean-value? value -> value-type value = int-type.

value-type value = int-type ->
  (boolean-value? value <->
     (int-payload value = 0 or int-payload value = 1)).

> A string is exactly a list whose elements are all chars. The empty list is
> therefore both a string and any other role compatible with empty list data.
string-value? value <->
  (value-type value = list-type and
   (all index: Nat, index <= list-length value |
     value-type (list-element value index) = char-type)).

> Whole-value matching is reflexive.
matches? value value.

> Whole-value matching is symmetric.
matches? left right -> matches? right left.

> Whole-value matching is transitive.
all first: Value, second: Value, third: Value,
    matches? first second,
    matches? second third |
  matches? first third.

> Values match only as numbers across the two numeric kinds, or within the
> same non-numeric kind.
matches? left right ->
  (numeric-value? left and numeric-value? right) or
  (value-type left = char-type and value-type right = char-type) or
  (value-type left = symbol-type and value-type right = symbol-type) or
  (value-type left = list-type and value-type right = list-type) or
  (value-type left = dict-type and value-type right = dict-type) or
  (value-type left = task-type and value-type right = task-type) or
  (value-type left = port-type and value-type right = port-type) or
  (value-type left = address-type and value-type right = address-type).

> Numeric matching is exact mathematical-value equality across int and float.
numeric-value? left and
numeric-value? right ->
  (matches? left right <->
     numeric-magnitude left = numeric-magnitude right).

> Equal int magnitudes are exactly equal int payloads.
value-type left = int-type and
value-type right = int-type ->
  (numeric-magnitude left = numeric-magnitude right <->
     int-payload left = int-payload right).

> Chars and symbols match exactly when their scalar contents match.
value-type left = char-type and
value-type right = char-type ->
  (matches? left right <->
     char-codepoint left = char-codepoint right).

value-type left = symbol-type and
value-type right = symbol-type ->
  (matches? left right <->
     symbol-spelling left = symbol-spelling right).

> Lists match recursively and positionally.
value-type left = list-type and
value-type right = list-type ->
  (matches? left right <->
     (list-length left = list-length right and
      (all index: Nat, index <= list-length left |
        matches? (list-element left index) (list-element right index)))).

> Whole-value matching is dictionary-key identity.
all dictionary: Value, key: Value, other: Value,
    value-type dictionary = dict-type,
    dict-has-key? dictionary key,
    matches? key other |
  dict-has-key? dictionary other.

all dictionary: Value, key: Value, other: Value,
    value-type dictionary = dict-type,
    dict-has-key? dictionary key,
    matches? key other |
  dict-value-for-key dictionary key = dict-value-for-key dictionary other.

> Dictionaries match exactly when they have the same keys and the values under
> each key match.
value-type left = dict-type and
value-type right = dict-type ->
  (matches? left right <->
     ((all key: Value |
        dict-has-key? left key <-> dict-has-key? right key) and
      (all key: Value, dict-has-key? left key, dict-has-key? right key |
        matches?
          (dict-value-for-key left key)
          (dict-value-for-key right key)))).

> A task value only matches itself.
value-type left = task-type and
value-type right = task-type ->
  (matches? left right <-> left = right).

> A port value only matches itself.
value-type left = port-type and
value-type right = port-type ->
  (matches? left right <-> left = right).

> An address names the mailbox of one task capability.
value-type (address-mailbox value) = task-type.

> Address values match when they correspond to the same task.
value-type left = address-type and
value-type right = address-type ->
  (matches? left right <->
     address-mailbox left = address-mailbox right).

> Scalar source kinds have readable representations.
(value-type value = int-type or
 value-type value = float-type or
 value-type value = char-type or
 value-type value = symbol-type) ->
  readable? value.

> Task, port, and address values have diagnostic displays but no readable
> representations.
(value-type value = task-type or
 value-type value = port-type or
 value-type value = address-type) ->
  ~readable? value.

> A list is readable exactly when all its elements are readable.
value-type value = list-type ->
  (readable? value <->
     (all index: Nat, index <= list-length value |
       readable? (list-element value index))).

> A dictionary is readable exactly when all its keys and values are readable.
value-type value = dict-type ->
  (readable? value <->
     (all key: Value, dict-has-key? value key |
       readable? key and
       readable? (dict-value-for-key value key))).

> Hashing is congruent with whole-value matching.
matches? left right -> value-hash left = value-hash right.

where


> `matches?` is the equivalence exposed by `match?` and used for dictionary-key
> identity. Lists match recursively by position. Dictionaries match by their
> key-value pairs. Task and port values match
> only themselves. Resolution context, source spans, provenance, and
> storage identity are absent from these rules and therefore cannot affect
> matching or hashing.
matches? left: Value, right: Value => Bool.
---
