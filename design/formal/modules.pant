module ECL_MODULES.

import ECL_VALUES.

context Calls.
context Construction.
context Registry.

RegistryName.
BindingName.
> This model is normative for registry names, aliases, generations, and
> publication, including the construction of the images they publish;
> abstract definitions and visibility; and call contexts and generation pins.
> Modules are pure code: a registration carries no operand stack and no
> state of its own, and a generation is nothing but an image published under
> a name.
>
> It deliberately abstracts over source spelling and name validation,
> construction-body evaluation (including the refusal of a body that leaves
> values on its stack), concrete and nested values, error construction and
> propagation, task and unit ownership, scheduling and fairness, and storage
> reclamation. The surrounding language specification governs those subjects.
> Begin and complete actions expose semantic concurrency boundaries; they are
> not ECL words. Contexts grant formal write authority and do not denote
> runtime values or additional language state. An `InvocationContext` is
> either the top-level evaluator or identifies the exact active call
> performing a registry mutation.
>
> A qualified call resolves a registry name and public binding and pins the
> name's current image in one atomic action. Resolution before replacement
> retains the selected image; resolution afterward observes only the
> replacement. Explicit qualification
> always performs this fresh registry dispatch, including when it names the
> caller's own module.
Calls ~> Begin qualified call @ module-name: RegistryName, binding-name: BindingName.
---
canonical? module-name or alias? module-name.
some call: Call,
     image: Image,
     definition: Definition,
     ~call-created? call,
     image = image-of module-name,
     binding-present? image binding-name,
     definition = definition-at image binding-name,
     public? definition |
  call-created?' call and
  call-active?' call and
  call-image' call = image and
  call-definition' call = definition and
  (all other: Call, other != call |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    call-image' other = call-image other and
    call-definition' other = call-definition other).

where

> The model has one kind of module object: an immutable image, published
> under exactly one canonical name as one generation. Reload publishes a new
> image under the same name and retires the previous one. No action removes a
> registration. A name is live while it maps to a
> published, non-retired image, which is that name's current generation. A
> live canonical name has zero or more direct aliases.
>
> Definitions are immutable background relations. Each definition belongs to
> one image and binding name, binding names are unique within an image, and
> visibility controls which call actions may select it. The model begins with
> no constructed images, occupied names, published generations, or calls.
> Domain atoms are possibilities rather than initially existing language
> values.
>
> Retirement is monotonic: replacement retires the former current
> image and no retired image becomes current again. Active calls retain their
> selected images.
Call.
Image.
Definition.
WordOccurrence.
InvocationContext.

{Calls} call-active? call: Call => Bool.
{Calls} call-created? call: Call => Bool.
{Calls} call-image call: Call => Image.
{Calls} call-definition call: Call => Definition.

occurrence-name occurrence: WordOccurrence => BindingName.
occurrence-image occurrence: WordOccurrence => Image.

call-invocation? invoker: InvocationContext => Bool.
invocation-call invoker: InvocationContext => Call.

{Construction} constructed? image: Image => Bool.

{Registry} canonical? name: RegistryName => Bool.
{Registry} alias? name: RegistryName => Bool.
{Registry} image-of name: RegistryName => Image.
{Registry} image-published? image: Image => Bool.
{Registry} image-retired? image: Image => Bool.
{Registry} image-name image: Image => RegistryName.

binding-present? image: Image, name: BindingName => Bool.
definition-at image: Image, name: BindingName => Definition.
definition-image definition: Definition => Image.
definition-name definition: Definition => BindingName.
public? definition: Definition => Bool.
---
all image: Image, name: BindingName, binding-present? image name |
  definition-image (definition-at image name) = image and
  definition-name (definition-at image name) = name.

all left: Definition, right: Definition,
    definition-image left = definition-image right,
    definition-name left = definition-name right |
  left = right.

initially all image: Image, name: BindingName, binding-present? image name |
  definition-image (definition-at image name) = image and
  definition-name (definition-at image name) = name.

initially all left: Definition, right: Definition,
    definition-image left = definition-image right,
    definition-name left = definition-name right |
  left = right.

all registry-name: RegistryName |
  ~(canonical? registry-name and alias? registry-name).

> A live name maps to its current generation.
all registry-name: RegistryName,
    canonical? registry-name or alias? registry-name |
  image-published? (image-of registry-name) and
  ~image-retired? (image-of registry-name).

all registry-name: RegistryName, canonical? registry-name |
  image-name (image-of registry-name) = registry-name.

> An alias resolves to the current image of a live canonical name.
all registry-name: RegistryName, alias? registry-name |
  canonical? (image-name (image-of registry-name)) and
  image-of (image-name (image-of registry-name)) = image-of registry-name.

all image: Image, image-published? image |
  constructed? image.

> An image exists only as a published generation: no program can hold one
> any other way.
all image: Image, constructed? image |
  image-published? image.

all image: Image, image-retired? image |
  image-published? image.

> A published image that is not retired is current under its own name.
all image: Image,
    image-published? image,
    ~image-retired? image |
  canonical? (image-name image) and
  image-of (image-name image) = image.

all call: Call, call-active? call |
  call-created? call.

all call: Call, call-active? call |
  constructed? (call-image call) and
  definition-image (call-definition call) = call-image call.

initially all image: Image |
  ~constructed? image and ~image-published? image and ~image-retired? image.

initially all registry-name: RegistryName |
  ~canonical? registry-name and ~alias? registry-name.

initially all call: Call |
  ~call-created? call and ~call-active? call.

some invoker: InvocationContext | ~call-invocation? invoker.

initially some invoker: InvocationContext | ~call-invocation? invoker.

where

> `Register` is `@defm`'s publication: it constructs a fresh image and
> publishes it in one step, because no program can observe an image between
> the two. It is an ordered upsert. Publishing under a missing canonical name
> creates the registration; publishing under an existing canonical name
> retires that name's current image, and every alias of the name resolves to
> the new image from then on. Nothing else carries over. The supplied
> invocation context is the top-level evaluator or the exact call performing
> the mutation.
Registry, Construction ~> Register @ invoker: InvocationContext,
                                     image: Image,
                                     module-name: RegistryName,
                                     ~constructed? image,
                                     ~alias? module-name.
---
  canonical?' module-name and
  ~alias?' module-name and
  image-of' module-name = image and
  (all other-name: RegistryName, other-name != module-name |
    canonical?' other-name = canonical? other-name and
    alias?' other-name = alias? other-name and
    ((canonical? module-name and
      alias? other-name and
      image-of other-name = image-of module-name) ->
      image-of' other-name = image) and
    (~(canonical? module-name and
       alias? other-name and
       image-of other-name = image-of module-name) ->
      image-of' other-name = image-of other-name)) and

  image-published?' image and
  ~image-retired?' image and
  image-name' image = module-name and
  constructed?' image and
  (all other-image: Image, other-image != image |
    constructed?' other-image = constructed? other-image and
    image-published?' other-image = image-published? other-image and
    image-retired?' other-image =
      (image-retired? other-image or
       (canonical? module-name and other-image = image-of module-name)) and
    image-name' other-image = image-name other-image).

where

> `Add alias` resolves either kind of occupied target name and stores a direct
> reference to its current image; semantic alias chains do not exist. The
> alias follows the canonical name through reload. Canonical and
> alias names form one disjoint namespace, and an occupied name cannot be
> repointed. The supplied invocation context is the top-level evaluator or the
> exact call performing the mutation.
Registry ~> Add alias @ invoker: InvocationContext,
                        alias-name: RegistryName,
                        target-name: RegistryName,
                        ~canonical? alias-name,
                        ~alias? alias-name,
                        canonical? target-name or alias? target-name.
---
  ~canonical?' alias-name and
  alias?' alias-name and
  image-of' alias-name = image-of target-name and
  (all other-name: RegistryName, other-name != alias-name |
    canonical?' other-name = canonical? other-name and
    alias?' other-name = alias? other-name and
    image-of' other-name = image-of other-name) and

  (all image: Image |
    image-published?' image = image-published? image and
    image-retired?' image = image-retired? image and
    image-name' image = image-name image).

where

> `Begin scoped call` resolves the name stored in a word occurrence against the
> image stored in that occurrence. A quotation or word occurrence owns this
> scope but does not cache a definition. The image must still be current or
> held by another active call. Private definitions are available to
> same-image scoped resolution without becoming publicly invocable.
Calls ~> Begin scoped call @ caller: Call,
                             occurrence: WordOccurrence,
                             binding-name: BindingName,
                             call-active? caller,
                             occurrence-name occurrence = binding-name.
---
some image: Image,
     image = occurrence-image occurrence,
     constructed? image,
     (image-published? image and ~image-retired? image) or
       #(each owner: Call,
              call-active? owner and call-image owner = image |
           owner) > 0,
     binding-present? image binding-name,
     definition: Definition,
     definition = definition-at image binding-name,
     (public? definition or call-image caller = definition-image definition),
     callee: Call,
     ~call-created? callee |
  call-created?' callee and
  call-active?' callee and
  call-image' callee = image and
  call-definition' callee = definition and
  (all other: Call, other != callee |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    call-image' other = call-image other and
    call-definition' other = call-definition other).

where

> `Complete call` releases the call's image pin after its invocation has
> completed. Calls are split into begin and complete actions only to express
> publication concurrency; the prose-level invocation remains one language
> operation.
Calls ~> Complete call @ completed: Call,
                       call-active? completed.
---
call-created?' completed = call-created? completed and
  ~call-active?' completed and
  call-image' completed = call-image completed and
  call-definition' completed = call-definition completed and

  (all other: Call, other != completed |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    call-image' other = call-image other and
    call-definition' other = call-definition other).
