module ECLMODULES.

context Calls.
context Images.
context Registry.
context Transactions.
context WithinCommit.

RegistryName.
BindingName.
> This model is normative for module-image availability; registry names,
> slots, aliases, generations, and publication; abstract definitions and
> visibility; call contexts and generation pins; the ordered durable, draft,
> pending-output, and ambient stacks; and atomic completion or abortion of
> `within` transactions.
>
> It deliberately abstracts over source spelling and name validation,
> construction-body evaluation, concrete and nested values, error construction
> and propagation, task and unit ownership, scheduling and fairness, and
> storage reclamation. The surrounding language specification governs those
> subjects. Begin and complete actions expose semantic concurrency boundaries;
> they are not ECL words. Contexts, including `WithinCommit`, grant formal
> write authority and do not denote runtime values or additional language
> state.
>
> A qualified call resolves a registry name and public binding and pins the
> slot's current generation in one atomic action. Resolution before replacement
> or removal retains the selected generation; resolution afterward observes
> only the replacement or the absence of the registration. Explicit
> qualification always performs this fresh registry dispatch, including when
> it names the caller's own registration.
Calls ~> Begin qualified call @ module-name: RegistryName, binding-name: BindingName.
---
canonical? module-name or alias? module-name.
some call: Call,
     slot: Slot,
     generation: Generation,
     image: Image,
     definition: Definition,
     ~call-created? call,
     slot = slot-of module-name,
     slot-live? slot,
     generation = current-generation slot,
     image = generation-image generation,
     binding-present? image binding-name,
     definition = definition-at image binding-name,
     public? definition |
  call-created?' call and
  call-active?' call and
  registered-call?' call and
  call-generation' call = generation and
  call-slot' call = slot and
  call-image' call = image and
  call-definition' call = definition and
  (all other: Call, other != call |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    registered-call?' other = registered-call? other and
    call-generation' other = call-generation other and
    call-slot' other = call-slot other and
    call-image' other = call-image other and
    call-definition' other = call-definition other).

all call: Call |
  ambient-depth' call = ambient-depth call.

all call: Call, position: Nat |
  ambient-value' call position = ambient-value call position.

where

> The model distinguishes immutable module images, durable registration slots,
> and publication generations. One image may be published into several slots;
> every successful publication creates a distinct generation. A live slot has
> exactly one canonical name, zero or more direct aliases, one current
> non-retired generation, and one durable stack. The image supplies only the
> initial stack template used when a fresh slot is created.
>
> Definitions and initial templates are immutable background relations. Each
> definition belongs to one image and binding name, binding names are unique
> within an image, and visibility controls which call actions may select it.
> The model begins with no constructed or value-held images, created or live
> slots, occupied names, published generations, calls, or transactions. Domain
> atoms are possibilities rather than initially existing language values.
>
> Retirement is monotonic: replacement or removal retires the former current
> generation and no retired generation becomes current again. Active calls
> retain their selected images and, for registered calls, their generations.
> An active transaction belongs to one active registered call and its still
> current live slot. At most one transaction may belong to a call or slot.
Call.
Slot.
Generation.
Image.
Definition.
Transaction.
Value.
WordOccurrence.

{Calls} call-active? call: Call => Bool.
{Calls} call-created? call: Call => Bool.
{Calls} registered-call? call: Call => Bool.
{Calls} call-generation call: Call => Generation.
{Calls} call-slot call: Call => Slot.
{Calls} call-image call: Call => Image.
{Calls} call-definition call: Call => Definition.
{Calls, WithinCommit} ambient-depth call: Call => Nat0.
{Calls, WithinCommit} ambient-value call: Call, position: Nat => Value.

invoked-image invocation: Call => Image.

occurrence-name occurrence: WordOccurrence => BindingName.
occurrence-image occurrence: WordOccurrence => Image.

{Images} constructed? image: Image => Bool.
{Images} value-held? image: Image => Bool.

{Registry} canonical? name: RegistryName => Bool.
{Registry} alias? name: RegistryName => Bool.
{Registry} slot-of name: RegistryName => Slot.
{Registry} slot-created? slot: Slot => Bool.
{Registry} slot-live? slot: Slot => Bool.
{Registry} current-generation slot: Slot => Generation.
{Registry} generation-published? generation: Generation => Bool.
{Registry} generation-retired? generation: Generation => Bool.
{Registry} generation-slot generation: Generation => Slot.
{Registry} generation-image generation: Generation => Image.
{Registry, WithinCommit} durable-depth slot: Slot => Nat0.
{Registry, WithinCommit} durable-value slot: Slot, position: Nat => Value.

{Transactions, WithinCommit} transaction-active? transaction: Transaction => Bool.
{Transactions} transaction-created? transaction: Transaction => Bool.
{Transactions} transaction-call transaction: Transaction => Call.
{Transactions} transaction-slot transaction: Transaction => Slot.
{Transactions} transaction-generation transaction: Transaction => Generation.
{Transactions, WithinCommit} draft-depth transaction: Transaction => Nat0.
{Transactions} draft-value transaction: Transaction, position: Nat => Value.
{Transactions, WithinCommit} pending-depth transaction: Transaction => Nat0.
{Transactions} pending-value transaction: Transaction, position: Nat => Value.

binding-present? image: Image, name: BindingName => Bool.
definition-at image: Image, name: BindingName => Definition.
definition-image definition: Definition => Image.
definition-name definition: Definition => BindingName.
public? definition: Definition => Bool.
initial-depth image: Image => Nat0.
initial-value image: Image, position: Nat => Value.
---
all image: Image, name: BindingName, binding-present? image name |
  definition-image (definition-at image name) = image and
  definition-name (definition-at image name) = name.

all left: Definition, right: Definition,
    definition-image left = definition-image right,
    definition-name left = definition-name right |
  left = right.

initially all image: Image, name: BindingName, binding-present? image name |
  definition-image (definition-at image name) = image and
  definition-name (definition-at image name) = name.

initially all left: Definition, right: Definition,
    definition-image left = definition-image right,
    definition-name left = definition-name right |
  left = right.

all registry-name: RegistryName |
  ~(canonical? registry-name and alias? registry-name).

all registry-name: RegistryName,
    canonical? registry-name or alias? registry-name |
  slot-live? (slot-of registry-name).

all slot: Slot, slot-live? slot |
  slot-created? slot.

all slot: Slot, slot-live? slot |
  #(each registry-name: RegistryName,
         canonical? registry-name and slot-of registry-name = slot |
      registry-name) = 1.

all slot: Slot, slot-live? slot |
  generation-published? (current-generation slot) and
  ~generation-retired? (current-generation slot) and
  generation-slot (current-generation slot) = slot.

all generation: Generation, generation-published? generation |
  constructed? (generation-image generation).

all image: Image, value-held? image |
  constructed? image.

all generation: Generation, generation-retired? generation |
  generation-published? generation.

all generation: Generation,
    generation-published? generation,
    ~generation-retired? generation |
  slot-live? (generation-slot generation) and
  current-generation (generation-slot generation) = generation.

all call: Call, call-active? call |
  call-created? call.

all call: Call, call-active? call |
  constructed? (call-image call) and
  definition-image (call-definition call) = call-image call.

all call: Call, call-active? call, registered-call? call |
  generation-published? (call-generation call) and
  generation-slot (call-generation call) = call-slot call and
  generation-image (call-generation call) = call-image call.

all transaction: Transaction, transaction-active? transaction |
  transaction-created? transaction.

all transaction: Transaction, transaction-active? transaction |
  call-active? (transaction-call transaction) and
  registered-call? (transaction-call transaction) and
  transaction-slot transaction = call-slot (transaction-call transaction) and
  transaction-generation transaction = call-generation (transaction-call transaction) and
  slot-live? (transaction-slot transaction) and
  current-generation (transaction-slot transaction) = transaction-generation transaction.

all left: Transaction, right: Transaction,
    transaction-active? left,
    transaction-active? right,
    transaction-call left = transaction-call right |
  left = right.

all left: Transaction, right: Transaction,
    transaction-active? left,
    transaction-active? right,
    transaction-slot left = transaction-slot right |
  left = right.

initially all image: Image |
  ~constructed? image and ~value-held? image.

initially all registry-name: RegistryName |
  ~canonical? registry-name and ~alias? registry-name.

initially all slot: Slot |
  ~slot-created? slot and ~slot-live? slot.

initially all generation: Generation |
  ~generation-published? generation and ~generation-retired? generation.

initially all call: Call |
  ~call-created? call and ~call-active? call.

initially all transaction: Transaction |
  ~transaction-created? transaction and ~transaction-active? transaction.

where

> `Construct image` allocates a fresh image identity and establishes its first
> module-value owner. Its immutable definition map and initial stack template
> already exist as background relations. Construction creates no name, slot,
> alias, or generation. Failure before this transition changes no modeled
> state; evaluation of the body and any external effects are outside this
> abstraction.
Images ~> Construct image.
---
some image: Image, ~constructed? image |
  constructed?' image and
  value-held?' image and
  (all other: Image, other != image |
    constructed?' other = constructed? other and
    value-held?' other = value-held? other).

where

> Image availability follows semantic ownership rather than reclamation
> mechanics. `value-held?` records that at least one reachable module value
> owns the image, not a reference count. `Release last value owner` clears that
> fact only when the final such owner disappears. The action models
> reachability and is not an ECL operation. Current generations and active
> calls are the other image owners; scoped words and quotations are not.
Images ~> Release last value owner @ image: Image,
                                        constructed? image,
                                        value-held? image.
---
~value-held?' image and
(all other: Image, other != image |
  value-held?' other = value-held? other).

all image: Image |
  constructed?' image = constructed? image.

where

> `Register` is an ordered upsert. Publishing under a missing canonical name
> creates a fresh slot initialized from the image's initial template.
> Publishing under an existing canonical name preserves that slot and its
> complete durable stack. Every successful registration publishes a fresh
> generation and retires the previous current generation, even when both
> generations contain the same image. It cannot interleave with an active
> transaction on the selected slot or be performed by a call that owns an
> active transaction.
Registry ~> Register @ image: Image,
                       module-name: RegistryName,
                       constructed? image,
                       value-held? image,
                       ~alias? module-name.
---
some caller: Call,
     call-active? caller,
     #(each transaction: Transaction,
            transaction-active? transaction and
            transaction-call transaction = caller |
         transaction) = 0,
     slot: Slot,
     (canonical? module-name and slot = slot-of module-name) or
       (~canonical? module-name and ~slot-created? slot),
     #(each transaction: Transaction,
            transaction-active? transaction and
            transaction-slot transaction = slot |
         transaction) = 0,
     generation: Generation,
     ~generation-published? generation |
  canonical?' module-name and
  ~alias?' module-name and
  slot-of' module-name = slot and
  (all other-name: RegistryName, other-name != module-name |
    canonical?' other-name = canonical? other-name and
    alias?' other-name = alias? other-name and
    slot-of' other-name = slot-of other-name) and

  slot-created?' slot and
  slot-live?' slot and
  current-generation' slot = generation and
  (all other-slot: Slot, other-slot != slot |
    slot-created?' other-slot = slot-created? other-slot and
    slot-live?' other-slot = slot-live? other-slot and
    current-generation' other-slot = current-generation other-slot) and

  generation-published?' generation and
  ~generation-retired?' generation and
  generation-slot' generation = slot and
  generation-image' generation = image and
  (all other-generation: Generation, other-generation != generation |
    generation-published?' other-generation =
      generation-published? other-generation and
    generation-retired?' other-generation =
      (generation-retired? other-generation or
       (canonical? module-name and
        other-generation = current-generation slot)) and
    generation-slot' other-generation = generation-slot other-generation and
    generation-image' other-generation = generation-image other-generation) and

  (canonical? module-name ->
    durable-depth' slot = durable-depth slot) and
  (~canonical? module-name ->
    durable-depth' slot = initial-depth image) and
  (all position: Nat |
    (canonical? module-name ->
      durable-value' slot position = durable-value slot position) and
    (~canonical? module-name ->
      durable-value' slot position = initial-value image position)) and
  (all other-slot: Slot, other-slot != slot |
    durable-depth' other-slot = durable-depth other-slot and
    (all position: Nat |
      durable-value' other-slot position =
        durable-value other-slot position)).

where

> `Add alias` resolves either kind of occupied target name and stores a direct
> reference to its live slot; semantic alias chains do not exist. The alias
> shares the slot's current generation, durable stack, serialization, and
> lifetime. Canonical and alias names form one disjoint namespace, and an
> occupied name cannot be repointed. Registry mutation is unavailable to a
> call that owns an active transaction.
Registry ~> Add alias @ alias-name: RegistryName,
                        target-name: RegistryName,
                        ~canonical? alias-name,
                        ~alias? alias-name,
                        canonical? target-name or alias? target-name.
---
some caller: Call,
     call-active? caller,
     #(each transaction: Transaction,
            transaction-active? transaction and
            transaction-call transaction = caller |
         transaction) = 0 |
  ~canonical?' alias-name and
  alias?' alias-name and
  slot-of' alias-name = slot-of target-name and
  (all other-name: RegistryName, other-name != alias-name |
    canonical?' other-name = canonical? other-name and
    alias?' other-name = alias? other-name and
    slot-of' other-name = slot-of other-name) and

  (all slot: Slot |
    slot-created?' slot = slot-created? slot and
    slot-live?' slot = slot-live? slot and
    current-generation' slot = current-generation slot and
    durable-depth' slot = durable-depth slot and
    (all position: Nat |
      durable-value' slot position = durable-value slot position)) and

  (all generation: Generation |
    generation-published?' generation = generation-published? generation and
    generation-retired?' generation = generation-retired? generation and
    generation-slot' generation = generation-slot generation and
    generation-image' generation = generation-image generation).

where

> `Remove` resolves a canonical name or alias to its slot, then atomically
> closes that slot, removes its canonical name and every alias, retires its
> current generation, and discards its durable stack. Removal does not end
> already active calls, whose pins remain valid, but those calls cannot start a
> new transaction after closure. A later registration of the same spelling
> must allocate a fresh slot. Removal cannot interleave with a transaction on
> the slot or be performed by a call that owns an active transaction.
Registry ~> Remove @ module-name: RegistryName,
                     canonical? module-name or alias? module-name.
---
some caller: Call,
     call-active? caller,
     #(each transaction: Transaction,
            transaction-active? transaction and
            transaction-call transaction = caller |
         transaction) = 0,
     slot: Slot,
     slot = slot-of module-name,
     #(each transaction: Transaction,
            transaction-active? transaction and
            transaction-slot transaction = slot |
         transaction) = 0 |
  (all registry-name: RegistryName |
    canonical?' registry-name =
      (canonical? registry-name and slot-of registry-name != slot) and
    alias?' registry-name =
      (alias? registry-name and slot-of registry-name != slot) and
    slot-of' registry-name = slot-of registry-name) and

  slot-created?' slot = slot-created? slot and
  ~slot-live?' slot and
  current-generation' slot = current-generation slot and
  durable-depth' slot = 0 and
  (all position: Nat |
    durable-value' slot position = durable-value slot position) and
  (all other-slot: Slot, other-slot != slot |
    slot-created?' other-slot = slot-created? other-slot and
    slot-live?' other-slot = slot-live? other-slot and
    current-generation' other-slot = current-generation other-slot and
    durable-depth' other-slot = durable-depth other-slot and
    (all position: Nat |
      durable-value' other-slot position =
        durable-value other-slot position)) and

  (all generation: Generation |
    generation-published?' generation = generation-published? generation and
    generation-retired?' generation =
      (generation-retired? generation or
       generation = current-generation slot) and
    generation-slot' generation = generation-slot generation and
    generation-image' generation = generation-image generation).

where

> `Begin image call` invokes a public binding through a module value. The
> invocation pins the image directly and has no registration, slot, or
> generation context. The image must still have a module-value owner when the
> call begins.
Calls ~> Begin image call @ binding-name: BindingName.
---
some callee: Call,
     ~call-created? callee,
     image: Image,
     image = invoked-image callee,
     constructed? image,
     value-held? image,
     binding-present? image binding-name,
     definition: Definition,
     definition = definition-at image binding-name,
     public? definition |
  call-created?' callee and
  call-active?' callee and
  ~registered-call?' callee and
  call-generation' callee = call-generation callee and
  call-slot' callee = call-slot callee and
  call-image' callee = image and
  call-definition' callee = definition and
  (all other: Call, other != callee |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    registered-call?' other = registered-call? other and
    call-generation' other = call-generation other and
    call-slot' other = call-slot other and
    call-image' other = call-image other and
    call-definition' other = call-definition other) and

  (all call: Call |
    ambient-depth' call = ambient-depth call and
    (all position: Nat |
      ambient-value' call position = ambient-value call position)).

where

> `Begin scoped call` resolves the name stored in a word occurrence against the
> image stored in that occurrence. A quotation or word occurrence owns this
> scope but does not cache a definition or generation. The image must still be
> available through a module value, a current generation, or another active
> call. Same-image dispatch from a registered caller preserves its pinned slot
> and generation; other scoped dispatch has no registration context. Private
> definitions are therefore available to same-image scoped resolution without
> becoming publicly invocable.
Calls ~> Begin scoped call @ binding-name: BindingName.
---
some caller: Call,
     call-active? caller,
     occurrence: WordOccurrence,
     occurrence-name occurrence = binding-name,
     image: Image,
     image = occurrence-image occurrence,
     constructed? image,
     value-held? image or
       #(each slot: Slot,
              slot-live? slot and
              generation-image (current-generation slot) = image |
           slot) > 0 or
       #(each owner: Call,
              call-active? owner and call-image owner = image |
           owner) > 0,
     binding-present? image binding-name,
     definition: Definition,
     definition = definition-at image binding-name,
     callee: Call,
     ~call-created? callee |
  call-created?' callee and
  call-active?' callee and
  registered-call?' callee =
    (registered-call? caller and call-image caller = image) and
  ((registered-call? caller and call-image caller = image) ->
    call-generation' callee = call-generation caller and
    call-slot' callee = call-slot caller) and
  (~(registered-call? caller and call-image caller = image) ->
    call-generation' callee = call-generation callee and
    call-slot' callee = call-slot callee) and
  call-image' callee = image and
  call-definition' callee = definition and
  (all other: Call, other != callee |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    registered-call?' other = registered-call? other and
    call-generation' other = call-generation other and
    call-slot' other = call-slot other and
    call-image' other = call-image other and
    call-definition' other = call-definition other) and

  (all call: Call |
    ambient-depth' call = ambient-depth call and
    (all position: Nat |
      ambient-value' call position = ambient-value call position)).

where

> `Complete call` releases the call's image and generation pins after its
> invocation has completed and no transaction belongs to it. Calls are split
> into begin and complete actions only to express publication concurrency; the
> prose-level invocation remains one language operation.
Calls ~> Complete call @ completed: Call,
                       call-active? completed,
                       #(each transaction: Transaction,
                              transaction-active? transaction and
                              transaction-call transaction = completed |
                           transaction) = 0.
---
call-created?' completed = call-created? completed and
  ~call-active?' completed and
  registered-call?' completed = registered-call? completed and
  call-generation' completed = call-generation completed and
  call-slot' completed = call-slot completed and
  call-image' completed = call-image completed and
  call-definition' completed = call-definition completed and
  ambient-depth' completed = 0 and
  (all position: Nat |
    ambient-value' completed position = ambient-value completed position) and

  (all other: Call, other != completed |
    call-created?' other = call-created? other and
    call-active?' other = call-active? other and
    registered-call?' other = registered-call? other and
    call-generation' other = call-generation other and
    call-slot' other = call-slot other and
    call-image' other = call-image other and
    call-definition' other = call-definition other and
    ambient-depth' other = ambient-depth other and
    (all position: Nat |
      ambient-value' other position = ambient-value other position)).

where

> `Begin within` requires an active registered call whose pinned generation is
> still current in a live slot. It allocates one transaction, copies the slot's
> durable stack into a private ordered draft, and begins with no pending
> outputs. It is unavailable for anonymous or homeless calls, for a retired or
> closed registration, while the caller already owns a transaction, or while
> another transaction owns the slot. Thus transactions never nest and are
> serialized per slot.
Transactions ~> Begin within @ caller: Call,
                             call-active? caller,
                             registered-call? caller,
                             slot-live? (call-slot caller),
                             current-generation (call-slot caller) =
                               call-generation caller,
                             #(each active: Transaction,
                                    transaction-active? active and
                                    transaction-call active = caller |
                                 active) = 0,
                             #(each active: Transaction,
                                    transaction-active? active and
                                    transaction-slot active = call-slot caller |
                                 active) = 0.
---
some slot: Slot,
     slot = call-slot caller,
     generation: Generation,
     generation = call-generation caller,
     transaction: Transaction,
     ~transaction-created? transaction |
  transaction-created?' transaction and
  transaction-active?' transaction and
  transaction-call' transaction = caller and
  transaction-slot' transaction = slot and
  transaction-generation' transaction = generation and
  draft-depth' transaction = durable-depth slot and
  (all position: Nat |
    draft-value' transaction position = durable-value slot position) and
  pending-depth' transaction = 0 and
  (all position: Nat |
    pending-value' transaction position = pending-value transaction position) and

  (all other: Transaction, other != transaction |
    transaction-created?' other = transaction-created? other and
    transaction-active?' other = transaction-active? other and
    transaction-call' other = transaction-call other and
    transaction-slot' other = transaction-slot other and
    transaction-generation' other = transaction-generation other and
    draft-depth' other = draft-depth other and
    pending-depth' other = pending-depth other and
    (all position: Nat |
      draft-value' other position = draft-value other position and
      pending-value' other position = pending-value other position)).

where

> `Without` removes the top value from a nonempty draft and appends it to the
> transaction's pending-output sequence. The sequence preserves invocation
> order. The guard makes the action unavailable outside an active transaction
> or on an empty draft; the prose specification assigns the corresponding ECL
> errors.
Transactions ~> Without @ transaction: Transaction,
                        transaction-active? transaction,
                        draft-depth transaction > 0.
---
some top: Nat,
     top = draft-depth transaction,
     destination: Nat,
     destination = pending-depth transaction + 1 |
  transaction-created?' transaction = transaction-created? transaction and
  transaction-active?' transaction = transaction-active? transaction and
  transaction-call' transaction = transaction-call transaction and
  transaction-slot' transaction = transaction-slot transaction and
  transaction-generation' transaction = transaction-generation transaction and
  draft-depth' transaction = draft-depth transaction - 1 and
  (all position: Nat |
    draft-value' transaction position = draft-value transaction position) and
  pending-depth' transaction = pending-depth transaction + 1 and
  pending-value' transaction destination = draft-value transaction top and
  (all position: Nat, position != destination |
    pending-value' transaction position = pending-value transaction position) and

  (all other: Transaction, other != transaction |
    transaction-created?' other = transaction-created? other and
    transaction-active?' other = transaction-active? other and
    transaction-call' other = transaction-call other and
    transaction-slot' other = transaction-slot other and
    transaction-generation' other = transaction-generation other and
    draft-depth' other = draft-depth other and
    pending-depth' other = pending-depth other and
    (all position: Nat |
      draft-value' other position = draft-value other position and
      pending-value' other position = pending-value other position)).

where

> `Commit within` is one atomic publication. The complete remaining draft
> replaces the slot's durable stack, and all pending outputs append to the
> caller's ambient stack in order. Neither stack exposes an intermediate state.
> The transaction then becomes inactive and relinquishes its private stacks.
WithinCommit ~> Commit within @ transaction: Transaction,
                              transaction-active? transaction.
---
some caller: Call,
     caller = transaction-call transaction,
     slot: Slot,
     slot = transaction-slot transaction |
  ~transaction-active?' transaction and
  draft-depth' transaction = 0 and
  pending-depth' transaction = 0 and
  (all other: Transaction, other != transaction |
    transaction-active?' other = transaction-active? other and
    draft-depth' other = draft-depth other and
    pending-depth' other = pending-depth other) and

  durable-depth' slot = draft-depth transaction and
  (all position: Nat |
    durable-value' slot position = draft-value transaction position) and
  (all other-slot: Slot, other-slot != slot |
    durable-depth' other-slot = durable-depth other-slot and
    (all position: Nat |
      durable-value' other-slot position =
        durable-value other-slot position)) and

  ambient-depth' caller =
    ambient-depth caller + pending-depth transaction and
  (all position: Nat, position <= ambient-depth caller |
    ambient-value' caller position = ambient-value caller position) and
  (all source: Nat, source <= pending-depth transaction |
    some destination: Nat,
         destination = ambient-depth caller + source |
      ambient-value' caller destination = pending-value transaction source) and
  (all position: Nat,
       position > ambient-depth caller + pending-depth transaction |
    ambient-value' caller position = ambient-value caller position) and
  (all other-call: Call, other-call != caller |
    ambient-depth' other-call = ambient-depth other-call and
    (all position: Nat |
      ambient-value' other-call position =
        ambient-value other-call position)).

where

> `Abort within` makes the transaction inactive and discards its draft and
> pending outputs without changing the durable or ambient stack. Effects not
> represented by those stacks lie outside the transaction and are not rolled
> back.
Transactions ~> Abort within @ transaction: Transaction,
                           transaction-active? transaction.
---
~transaction-active?' transaction and
transaction-created?' transaction = transaction-created? transaction and
transaction-call' transaction = transaction-call transaction and
transaction-slot' transaction = transaction-slot transaction and
transaction-generation' transaction = transaction-generation transaction and
draft-depth' transaction = 0 and
pending-depth' transaction = 0 and
(all position: Nat |
  draft-value' transaction position = draft-value transaction position and
  pending-value' transaction position = pending-value transaction position).

all other: Transaction, other != transaction |
  transaction-active?' other = transaction-active? other and
  transaction-created?' other = transaction-created? other and
  transaction-call' other = transaction-call other and
  transaction-slot' other = transaction-slot other and
  transaction-generation' other = transaction-generation other and
  draft-depth' other = draft-depth other and
  pending-depth' other = pending-depth other and
  (all position: Nat |
    draft-value' other position = draft-value other position and
    pending-value' other position = pending-value other position).
